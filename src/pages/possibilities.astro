---
import Base from '../layouts/Base.astro';
import World from '../components/World.astro';
import {projects} from '../data/content';
import {workflowFor} from '../lib/workflow';
import '../styles/journey.css';
const initial=workflowFor('website');
---
<Base title="Possibilities — a point becomes a presence" theme="exhibition" description="An authored Reachly exhibition. Follow one evolving ribbon-world from a point to a presence, a connected system and a wider possibility.">
<div class="continuous-journey continuous-journey--exhibition" data-world-mode="exhibition">
<nav class="chapter-nav" aria-label="Exhibition chapters"><a href="#mark" data-chapter="mark" aria-current="location"><span>01</span> Make a mark</a><a href="#frame" data-chapter="frame"><span>02</span> Open the frame</a><a href="#connect" data-chapter="connect"><span>03</span> Connect the dots</a><a href="#further" data-chapter="further"><span>04</span> Go further</a></nav>
<World mode="exhibition"/>
<div class="journey-content">
<section class="exhibit-opening journey-scene shell" id="mark" data-scene="0">
 <div class="scene-meta eyebrow"><span class="section-label">Reachly Possibilities / Exhibition 01</span><span>One point. One evolving world.</span></div>
 <div class="origin-copy"><span class="eyebrow">Look a little closer.</span><h1 class="display">Follow one<br/><em>possibility.</em></h1><p>A point becomes a line.<br/>A line opens a frame.<br/>A frame makes room for more.</p><a href="#frame" class="text-link">Follow the line ↓</a></div>
 <div class="signal-presets" role="group" aria-label="Ribbon world perspective"><span class="eyebrow">A different perspective</span><button data-perspective="0" aria-pressed="true">Focus</button><button data-perspective="1" aria-pressed="false">Flow</button><button data-perspective="2" aria-pressed="false">Reach</button></div>
 <div class="origin-bottom eyebrow"><span>Move near the world. Or choose a perspective.</span><span>Original motion study / 01</span></div>
</section>
<section class="frame-chapter journey-scene shell" id="frame" data-scene="1">
 <div class="scene-intro"><span class="eyebrow section-label">01 → 02 / The line opens a frame</span><h2 class="display">A point of view.<br/><em>A world beyond it.</em></h2><p>Real work enters the same space.<br/>Different businesses. Their own presence.</p></div>
 <div class="exhibit-gallery work-constellation">{projects.map((p,i)=><article class:list={['work-plane',`work-plane--${i}`]} data-world-plane={i}><a href={`/work/${p.slug}/`} class:list={['exhibit-project',{'portal-image':i===0}]}><span class="plane-tab eyebrow">0{i+1} / Selected client work ↗</span><div class="work-image"><img src={p.image} alt={`${p.name} — actual client website capture`} width={p.imageWidth} height={p.imageHeight} loading="lazy"/></div><div class="plane-caption"><h3>{p.name}</h3><span>{p.category}</span></div></a></article>)}</div>
 <div class="scene-foot"><span class="eyebrow">Real work, not a fictional world.</span><a class="text-link" href="/work/">Explore project notes ↗</a></div>
</section>
<section class="passage-chapter journey-scene shell" id="inside" data-scene="2">
 <div class="scene-intro"><span class="eyebrow section-label">Change the scale, not the story</span><h2 class="display">Step inside<br/><em>the possibility.</em></h2><p>The frame becomes a passage.<br/>The same line, seen from somewhere new.</p></div>
 <div class="passage-lens"><img src="/images/world/ribbon-passage.webp" width="1024" height="576" alt="Original conceptual Reachly ribbon sculpture, a close-up view into the lime material" loading="lazy"/><span class="lens-orbit" aria-hidden="true"></span><span class="eyebrow">Form → Space → Connection</span></div>
</section>
<section class="connection-chapter journey-scene shell" id="connect" data-scene="3">
 <div class="scene-intro"><span class="eyebrow section-label">02 → 03 / The line becomes a handoff</span><h2 class="display">Less friction.<br/><em>More flow.</em></h2><p>Good systems make the handoffs simpler.<br/>Follow one sample inquiry from arrival to attention.</p></div>
 <div class="flow-controls"><div role="group" aria-label="Illustrative workflow scenario"><button data-scenario="website" aria-pressed="true">Website inquiry</button><button data-scenario="follow-up" aria-pressed="false">Follow-up request</button></div><button class="button button--lime" id="run-flow">Run the example <span aria-hidden="true">↗</span></button></div>
 <div class="workflow" aria-label="Illustrative inquiry flow"><svg class="flow-lines" viewBox="0 0 1200 330" preserveAspectRatio="none" aria-hidden="true"><path d="M50 270C200 270 160 40 360 100S650 310 820 160S1050 90 1180 40"/><circle id="flow-signal" cx="50" cy="270" r="9"/></svg>{initial.steps.map((step,i)=><div class={`flow-node flow-node--${i}`} data-node={i}><span class="node-circle" aria-hidden="true">0{i+1}</span><h3>{step.label}</h3><p>{step.text}</p></div>)}</div>
 <div class="flow-status"><p id="flow-result" aria-live="polite">Choose a scenario, then run the example.</p><span class="eyebrow">In-house interaction study</span></div><p class="flow-disclaimer">Illustrative workflow — not connected to a live business system. Sample data only; nothing is sent or stored.</p><a href="/services/business-automation/" class="text-link">Explore business automation ↗</a>
</section>
<section class="reach-chapter journey-scene shell" id="reach" data-scene="4">
 <div class="scene-intro"><span class="eyebrow section-label">03 → 04 / Reconnect and extend</span><h2 class="display">The end of a line.<br/><em>Or a new direction.</em></h2><p>The handoffs come together.<br/>The point keeps moving.</p></div>
 <div class="reach-diagram" aria-hidden="true"><svg viewBox="0 0 1000 430"><path d="M-30 410C100 300 220 400 420 160S730 40 990 40M420 160C550 220 730 390 990 320"/><circle cx="990" cy="40" r="15"/><circle cx="990" cy="320" r="15"/><path d="M830 110L990 40L880 0"/></svg></div>
</section>
<section class="further-chapter journey-scene shell" id="further" data-scene="5">
 <div class="scene-intro"><span class="eyebrow section-label">The next point is yours</span><h2 class="display">Beautiful possibilities.<br/><em>Useful beginnings.</em></h2><p>This is an exploration of what an idea can become.<br/>Your business is where the useful work begins.</p><a class="button button--lime" href="/contact/?source=possibilities&interest=not-sure">Make room for your next idea <span aria-hidden="true">↗</span></a></div>
 <div class="resolution-mark" aria-hidden="true"><svg viewBox="0 0 500 400"><path d="M0 350C160 370 220 50 400 100S500 300 325 215L445 55M325 215L460 210"/><circle cx="445" cy="55" r="12"/></svg></div>
 <div class="exhibition-return scene-foot"><a href="/" class="text-link">Back to Studio ↖</a><a class="text-link" href="#mark">Explore again ↑</a></div>
</section>
</div>
<div class="world-hud" aria-hidden="true"><span class="hud-point"></span><span>Reachly / The living line</span><span data-world-caption>01 / Origin</span></div>
</div>
<script>import '../scripts/world';import '../scripts/exhibition';</script>
</Base>
