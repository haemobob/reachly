---
import Base from '../layouts/Base.astro';
import {projects} from '../data/content';
import {workflowFor} from '../lib/workflow';
import '../styles/exhibition.css';
const lead=projects.find(p=>p.slug==='sellaku')!;
const initial=workflowFor('website');
---
<Base title="Possibilities — a point becomes a presence" theme="exhibition" description="An interactive Reachly exhibition. A small beginning becomes a wider frame, a connected system, and a different perspective.">
<nav class="chapter-nav" aria-label="Exhibition chapters"><a class="chapter-brand" href="/" aria-label="Return to Reachly Studio"><img src="/brand/reachly-icon.svg" alt="" width="25" height="25" /></a><a href="#mark" data-chapter="mark" aria-current="location"><span>01</span> Make a mark</a><a href="#frame" data-chapter="frame"><span>02</span> Open the frame</a><a href="#connect" data-chapter="connect"><span>03</span> Connect the dots</a><a href="#further" data-chapter="further"><span>04</span> Go further</a><span class="chapter-edition">Wider Possibilities / 01</span></nav>
<section class="exhibit-opening shell" id="mark">
<div class="exhibit-meta eyebrow"><span class="section-label">An interactive exhibition by Reachly</span><span>Small beginnings. Wider possibilities.</span></div>
<div class="signal-composition"><div class="signal-type"><span class="eyebrow">01 / Make a mark</span><h1 class="display">It starts<br />with a <em>point.</em></h1><p>One small idea.<br />A different way of seeing.</p><a href="#frame" class="exhibit-explore">Follow the possibility <span aria-hidden="true">↓</span></a></div><div class="signal-art" id="signal-art" role="img" aria-label="An original lime signal field, responding to perspective"><div class="signal-fallback" aria-hidden="true"><svg viewBox="0 0 800 800">{Array.from({length:32},(_,i)=><ellipse cx="400" cy="400" rx={64+i*8.5} ry={36+i*9} transform={`rotate(${i*1.6-35} 400 400)`} />)}</svg><span></span></div></div></div>
<div class="signal-footer"><div class="signal-presets" role="group" aria-label="Signal field perspective"><span class="eyebrow">Change perspective</span><button data-perspective="0" aria-pressed="true">Focus</button><button data-perspective="1" aria-pressed="false">Flow</button><button data-perspective="2" aria-pressed="false">Reach</button></div><p class="signal-instruction">Move near the field. Or choose a perspective.<br />Every small change opens something different.</p></div>
</section>
<section class="frame-chapter" id="frame"><div class="shell frame-heading"><span class="eyebrow section-label">02 / Open the frame</span><h2 class="display">A point of view.<br /><em>A world beyond it.</em></h2><p>See the possibilities in real work.<br />Different businesses. Their own presence.</p></div><div class="portal"><div class="portal-rings" aria-hidden="true"></div><a href="/work/sellaku/" class="portal-image"><img src={lead.image} alt="Sellaku's furniture storefront, actual client website capture" width={lead.imageWidth} height={lead.imageHeight} loading="lazy" /></a><div class="portal-caption"><span class="eyebrow">Selected client work</span><span>Sellaku / Furniture & everyday spaces</span><a href="/work/sellaku/">View project ↗</a></div></div><div class="shell exhibit-gallery">{projects.map((p,i)=><a href={`/work/${p.slug}/`} class:list={['exhibit-project',`exhibit-project--${i}`]}><div><img src={p.image} alt={`${p.name} actual website capture`} width={p.imageWidth} height={p.imageHeight} loading="lazy" /><span aria-hidden="true">↗</span></div><p><span>{p.name}</span><span>0{i+1}</span></p><span class="exhibit-category">{p.category}</span></a>)}</div></section>
<section class="connection-chapter" id="connect"><div class="shell"><div class="connection-heading"><span class="eyebrow section-label">03 / Connect the dots</span><h2 class="display">Less friction.<br /><em>More flow.</em></h2><p>Good systems make the handoffs simpler.<br />Follow one inquiry from arrival to attention.</p></div><div class="flow-controls"><div role="group" aria-label="Illustrative workflow scenario"><button data-scenario="website" aria-pressed="true">Website inquiry</button><button data-scenario="follow-up" aria-pressed="false">Follow-up request</button></div><button class="button button--dark" id="run-flow">Run the example <span aria-hidden="true">↗</span></button></div><div class="workflow" aria-label="Illustrative inquiry flow"><svg class="flow-lines" viewBox="0 0 1200 230" preserveAspectRatio="none" aria-hidden="true"><path d="M80 115 C260 115 260 70 400 115 S650 160 800 115 S1010 70 1120 115" /><circle id="flow-signal" cx="80" cy="115" r="7" /></svg>{initial.steps.map((step,i)=><div class="flow-node" data-node={i}><span class="node-number">0{i+1}</span><span class="node-circle" aria-hidden="true">{i===0?'↘':i===3?'↗':'·'}</span><h3>{step.label}</h3><p>{step.text}</p></div>)}</div><div class="flow-status"><p id="flow-result" aria-live="polite">Choose a scenario, then run the example.</p><span class="eyebrow">In-house interaction study</span></div><p class="flow-disclaimer">Illustrative workflow — not connected to a live business system. Sample data only; nothing is sent or stored.</p><a href="/services/business-automation/" class="text-link">Explore business automation <span aria-hidden="true">↗</span></a></div></section>
<section class="further-chapter shell" id="further"><div class="further-meta eyebrow"><span class="section-label">04 / Go further</span><span>Curiosity → Clarity → Possibility</span></div><div class="further-art" aria-hidden="true">{Array.from({length:12},(_,i)=><span style={`--i:${i}`}></span>)}<b></b></div><h2 class="display">And this is<br /><em>just the beginning.</em></h2><div class="further-bottom"><p>Beautiful possibilities are worth exploring.<br />Useful ones are worth building.<br />What could yours become?</p><a class="button button--lime" href="/contact/?source=possibilities&interest=not-sure">Make room for your next idea <span aria-hidden="true">↗</span></a></div><div class="exhibition-return"><a href="/" class="text-link">Back to Studio <span aria-hidden="true">↖</span></a><a href="#mark">Explore again ↑</a></div></section>
<script>import '../scripts/exhibition';</script>
</Base>
