---
import Base from '../layouts/Base.astro';
import { projects, services, process as stages } from '../data/content';
import '../styles/studio.css';
const lead=projects.find(p=>p.slug==='sellaku')!;
const industrial=projects.find(p=>p.slug==='mac-one-indonesia')!;
---
<Base title="A bigger stage. A clearer next step." >
<section class="studio-hero shell">
<div class="hero-meta eyebrow"><span class="section-label">Design & technology, with a point of view.</span><span>For businesses in Indonesia ↘</span></div>
<div class="hero-composition">
<div class="hero-title"><h1 class="display">A bigger<br /><em>stage.</em><span class="headline-dot" aria-hidden="true"></span></h1><p class="hero-subtitle">A clearer next step.</p></div>
<div class="hero-art" aria-label="Selected client website, Sellaku">
<div class="orbit-stamp" aria-hidden="true"><svg viewBox="0 0 500 500">{Array.from({length:18},(_,i)=><ellipse cx="250" cy="250" rx={110+i*7} ry={53+i*8} transform={`rotate(${i*3-25} 250 250)`} />)}</svg></div>
<a href="/work/sellaku/" class="hero-project"><div class="project-window"><span>SELECTED WORK / 01</span><span aria-hidden="true">↗</span></div><img src={lead.image} alt="Sellaku furniture storefront, actual website capture" width={lead.imageWidth} height={lead.imageHeight} fetchpriority="high" /><div class="hero-project-label"><span>Sellaku</span><span>Furniture & everyday spaces</span></div></a>
<div class="hero-ticket"><span class="eyebrow">A point becomes<br />a presence.</span><span class="ticket-symbol" aria-hidden="true">↗</span></div>
</div>
</div>
<div class="hero-bottom"><p>We build websites, shape digital presence, and connect the tools behind your business. Thoughtful design. Practical next steps.</p><div class="hero-links"><a class="button button--dark" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a><a class="text-link" href="#selected">Explore the work <span aria-hidden="true">↓</span></a></div><span class="hero-scroll eyebrow">Scroll to see<br />what's possible ↓</span></div>
</section>
<section class="selected-work shell" id="selected">
<div class="section-heading"><span class="eyebrow section-label">01 / Selected work</span><h2 class="display">Different businesses.<br /><em>Distinct possibilities.</em></h2><a href="/work/" class="text-link">All work <span aria-hidden="true">↗</span></a></div>
<div class="work-pair">{[lead,industrial].map((p,i)=><article class:list={['work-feature',{'work-feature--offset':i===1}]}><a href={`/work/${p.slug}/`}><div class:list={['work-image',`work-image--${p.slug}`]}><img src={p.image} alt={`${p.name} — actual website capture`} width={p.imageWidth} height={p.imageHeight} loading="lazy" /><span class="image-arrow" aria-hidden="true">↗</span></div><div class="work-caption"><h3>{p.name}</h3><span>{p.category}</span></div><p>{p.summary}</p></a></article>)}</div>
<div class="work-pair work-pair--small">{projects.filter(p=>!['sellaku','mac-one-indonesia'].includes(p.slug)).map(p=><article class="work-feature"><a href={`/work/${p.slug}/`}><div class="work-image work-image--compact"><img src={p.image} alt={`${p.name} — actual website capture`} width={p.imageWidth} height={p.imageHeight} loading="lazy" /><span class="image-arrow" aria-hidden="true">↗</span></div><div class="work-caption"><h3>{p.name}</h3><span>{p.category}</span></div></a></article>)}</div>
</section>
<section class="studio-belief"><div class="shell belief-grid"><span class="eyebrow section-label">The point of it all</span><h2 class="display">Beautiful is<br />a beginning.<br /><em>Useful is the point.</em></h2><div class="belief-note"><span class="belief-orbit" aria-hidden="true">↗</span><p>A website should feel like your business. Make it clear. Make it credible. Make the next step easy.</p><a class="text-link" href="/about/">Our point of view <span aria-hidden="true">↗</span></a></div></div></section>
<section class="studio-services shell" id="services"><div class="section-heading"><span class="eyebrow section-label">02 / What we do</span><h2 class="display">Start with what<br /><em>needs to change.</em></h2><p>One coordinated approach.<br />Five ways to move forward.</p></div><div class="service-list">{services.map(s=><a class="service-line" href={`/services/${s.slug}/`}><span class="service-number eyebrow">{s.number}</span><div><h3>{s.name}</h3><p>{s.intro}</p></div><span class="service-go" aria-hidden="true">↗</span></a>)}</div><div class="service-foot"><p>You don't need to know all the answers.<br />A conversation is a good place to start.</p><a class="text-link" href="/contact/?interest=not-sure">Let's find the next step <span aria-hidden="true">↗</span></a></div></section>
<section class="studio-process shell"><div class="section-heading"><span class="eyebrow section-label">03 / A clear way forward</span><h2 class="display">Good things.<br /><em>Made together.</em></h2></div><div class="process-list">{stages.map((stage,i)=><article><span class="process-point" aria-hidden="true"></span><span class="eyebrow">0{i+1}</span><h3>{stage.name}</h3><p>{stage.text}</p></article>)}</div></section>
<section class="possibilities-invite"><div class="invite-lines" aria-hidden="true">{Array.from({length:13},(_,i)=><span style={`--i:${i}`}></span>)}</div><div class="shell invite-content"><div class="invite-top eyebrow"><span class="section-label">The other side of Reachly</span><span>An interactive exhibition / 01</span></div><h2 class="display">What if<br /><em>we went further?</em></h2><div class="invite-bottom"><p>A little curiosity. A different perspective.<br />Explore what an idea can become.</p><a class="button button--lime" href="/possibilities/">Enter Possibilities <span aria-hidden="true">↗</span></a></div></div></section>
<section class="studio-close shell"><span class="eyebrow section-label">Your next chapter</span><h2 class="display">Make room for<br /><em>what's next.</em><span aria-hidden="true">↗</span></h2><div><p>Tell us about your business.<br />Let's find the right place to begin.</p><a class="button button--dark" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a></div></section>
<script>import '../scripts/studio';</script>
</Base>
