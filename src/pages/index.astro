---
import Base from '../layouts/Base.astro';
import World from '../components/World.astro';
import { projects, services, process as stages } from '../data/content';
import '../styles/journey.css';
const lead=projects[0];
---
<Base title="A bigger stage. A clearer next step.">
<div class="continuous-journey" data-world-mode="studio">
<World mode="studio" />
<div class="journey-content">
<section class="studio-hero journey-scene shell" data-scene="0" id="origin">
 <div class="scene-meta eyebrow"><span class="section-label">Reachly / A point becomes a presence</span><span>Design & technology · Indonesia</span></div>
 <div class="origin-copy"><p class="eyebrow">A small beginning. A wider possibility.</p><h1 class="display">Your next<br/><em>possibility.</em></h1><p>Thoughtful websites.<br/>A clearer digital presence.<br/>Connected tools behind your business.</p><a class="button button--dark" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a></div>
 <a class="hero-project origin-work" href="/work/sellaku/"><span class="plane-tab eyebrow">A glimpse of real work ↗</span><img src={lead.image} alt="Sellaku furniture storefront, actual website capture" width={lead.imageWidth} height={lead.imageHeight}/><span class="plane-caption">Sellaku <span>Furniture storefront</span></span></a>
 <div class="origin-bottom eyebrow"><span>Follow the line ↓</span><span>Independent thinking.<br/>Practical next steps.</span></div>
</section>
<section class="selected-work journey-scene shell" id="selected" data-scene="1">
 <div class="scene-intro"><span class="eyebrow section-label">01 / Presence, in practice</span><h2 class="display">Different businesses.<br/><em>Their own space.</em></h2><p>The line opens a frame. The work makes it real.</p></div>
 <div class="work-constellation">{projects.map((p,i)=><article class:list={['work-plane',`work-plane--${i}`]} data-world-plane={i}><a href={`/work/${p.slug}/`}><span class="plane-tab eyebrow">0{i+1} / Selected client work <span aria-hidden="true">↗</span></span><div class="work-image"><img src={p.image} alt={`${p.name} — actual client website capture`} width={p.imageWidth} height={p.imageHeight} loading="lazy"/></div><div class="plane-caption"><h3>{p.name}</h3><span>{p.category}</span></div></a></article>)}</div>
 <div class="scene-foot"><p>Real businesses, real website captures.<br/>Explore the websites and factual project notes.</p><a class="text-link" href="/work/">Explore the projects ↗</a></div>
</section>
<section class="studio-services journey-scene shell" id="services" data-scene="2">
 <div class="scene-intro"><span class="eyebrow section-label">02 / One line. Many directions.</span><h2 class="display">Make the right<br/><em>connections.</em></h2><p>Design, clarity, visibility and useful technology.<br/>Choose a starting point. We help connect the rest.</p></div>
 <div class="capability-map"><svg class="capability-branches" viewBox="0 0 1200 720" preserveAspectRatio="none" aria-hidden="true"><path d="M580 700 C580 560 160 510 175 340 S330 130 315 65 M580 700 C580 500 600 410 600 65 M580 700 C580 520 980 500 1020 260 S950 180 950 65"/><circle cx="580" cy="700" r="10"/></svg>{services.map((s,i)=><a class:list={['capability-node',`capability-node--${i}`]} href={`/services/${s.slug}/`}><span class="node-registration eyebrow">{s.number} <span>↗</span></span><svg class="capability-symbol" viewBox="0 0 300 170" aria-hidden="true"><path d={['M25 145 L80 20 L270 40 L235 150 Z M80 20 L235 150 M25 145 L270 40','M30 130 C60 10 260 10 270 105 C260 180 70 180 65 50 M120 40 A40 40 0 1 1 119 40','M20 145 C75 155 65 35 130 50 S215 160 270 20 M20 145L45 120 M270 20L240 25','M20 135 C40 135 80 45 110 45 S180 130 210 130 S265 30 280 30 M110 45V130 M210 130V45','M45 135 C15 15 205 5 225 80 C240 135 155 170 110 125 M215 105 L280 150'][i]}/><circle cx="45" cy="135" r="7"/></svg><h3>{s.name}</h3><p>{s.intro}</p></a>)}</div>
 <div class="scene-foot"><span class="eyebrow">A coordinated approach, not a shopping list.</span><a class="text-link" href="/contact/?interest=not-sure">Find your starting point ↗</a></div>
</section>
<section class="studio-process journey-scene shell" data-scene="3" id="together">
 <div class="scene-intro"><span class="eyebrow section-label">03 / Bring it together</span><h2 class="display">A clear path.<br/><em>Made together.</em></h2><p>The work moves forward through shared decisions,<br/>not mysterious leaps.</p></div>
 <div class="process-route"><svg viewBox="0 0 1200 340" preserveAspectRatio="none" aria-hidden="true"><path d="M40 285 C180 285 125 60 350 130 S590 350 730 185 S1010 65 1170 40"/></svg>{stages.map((stage,i)=><article class={`process-stop process-stop--${i}`}><span class="route-point" aria-hidden="true"></span><span class="eyebrow">0{i+1} / The next step</span><h3>{stage.name}</h3><p>{stage.text}</p></article>)}</div>
</section>
<section class="possibilities-invite journey-scene shell" data-scene="4" id="beyond">
 <div class="scene-intro"><span class="eyebrow section-label">04 / The line keeps going</span><h2 class="display">A different light.<br/><em>The same possibility.</em></h2><p>Step closer to the world behind the work.<br/>An authored exhibition of motion, form and connected ideas.</p></div>
 <a href="/possibilities/" class="world-window"><div class="window-ribbon" aria-hidden="true"><svg viewBox="0 0 900 500"><path d="M-50 450C150 400 210 90 580 100S900 450 650 380S420 20 1050 60"/><circle cx="580" cy="100" r="13"/></svg></div><span class="eyebrow">Reachly Possibilities / Exhibition 01</span><strong>Follow it further <span>↗</span></strong><span class="window-note">Same point. A wider world.</span></a>
</section>
<section class="studio-close journey-scene shell" data-scene="5" id="next">
 <div class="scene-intro"><span class="eyebrow section-label">Your line starts here</span><h2 class="display">What could<br/><em>yours become?</em></h2><p>Tell us about your business.<br/>Let's find the right place to begin.</p><a class="button button--dark" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a></div>
 <div class="resolution-mark" aria-hidden="true"><svg viewBox="0 0 500 400"><path d="M0 350C160 370 220 50 400 100S500 300 325 215L445 55M325 215L460 210"/><circle cx="445" cy="55" r="12"/></svg></div>
 <span class="closing-note eyebrow">A point becomes a presence.<br/>A presence opens a possibility.</span>
</section>
</div>
<div class="world-hud" aria-hidden="true"><span class="hud-point"></span><span>Reachly / The living line</span><span data-world-caption>01 / Origin</span></div>
</div>
<script>import '../scripts/world';</script>
</Base>
