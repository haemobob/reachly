---
import Base from '../../layouts/Base.astro';
import { services, process } from '../../data/content';
import type { Service } from '../../data/content';
import '../../styles/pages.css';
export function getStaticPaths() {
  return services.map(service => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props as { service: Service };
const boundaries: Record<string, string> = {
  'website-design-development': 'Business websites, landing pages, and redesigns are the starting scope. E-commerce, complex applications, and specialist functionality need a separate assessment. Content production, hosting, domains, maintenance, and ongoing support are agreed explicitly.',
  'digital-presence': 'We agree which profiles and channels to review, who owns them, and what access is available. This is not an automatic social media management or advertising package. Channel updates and ongoing content responsibilities must be defined.',
  'digital-strategy': 'A roadmap is a decision-making tool, not a guarantee of growth. Research depth, deliverables, implementation, and follow-on support are agreed separately. Recommendations should match the resources you can realistically sustain.',
  'business-automation': 'We scope client workflows, not access to a proprietary Reachly platform. Integrations depend on provider capabilities, permissions, costs, and data handling. Human review, failure states, documentation, and support responsibilities belong in the agreement.',
  'seo': 'Search rankings, traffic, leads, and revenue are not guaranteed. The work is foundational technical and on-page SEO, with local search support where agreed. Scope, reporting, content production, and ongoing work are specified for each project.',
};
---
<Base title={service.name} description={service.intro}>
  <section class="shell page-intro service-intro"><a class="text-link" href="/services">← All services</a><div class="service-heading"><p class="eyebrow">Service / {service.number}</p><h1 class="display page-title">{service.name}</h1></div><div class="intro-tail"><span class="folio">{service.number} / 05</span><p class="lede">{service.intro}</p></div></section>
  <section class="shell section-space split-editorial service-explanation"><div><p class="eyebrow">The useful change</p><h2 class="display">What this<br /><em>makes room for.</em></h2></div><div class="reading"><p class="lede">{service.description}</p><p>A useful solution should fit your audience, your resources, and the people who will look after it. We start by understanding those conditions, then agree what should be designed, built, or changed.</p></div></section>
  <section class="scope-band"><div class="shell scope-grid"><div><p class="eyebrow">Possible outputs</p><h2 class="display">The work<br />can take shape as…</h2><p>Illustrative starting points, not a fixed package. The final deliverables are agreed for your project.</p></div><ol class="output-list">{service.outputs.map((output, index) => <li><span class="folio">0{index + 1}</span><span>{output}</span></li>)}</ol></div></section>
  <section class="shell section-space split-editorial"><div><p class="eyebrow">Before we begin</p><h2 class="display">Good questions.<br /><em>A clearer brief.</em></h2></div><div class="reading"><ul class="question-list">{service.questions.map(question => <li>{question}</li>)}</ul><div class="honesty-note"><h3>Where the scope starts and stops</h3><p>{boundaries[service.slug]}</p><p>Hosting, third-party subscriptions, maintenance, and support are only included when explicitly agreed. Timelines, costs, and responsibilities follow the confirmed scope.</p></div></div></section>
  <section class="shell process-strip" aria-labelledby="working-title"><div><p class="eyebrow">A shared way of working</p><h2 class="display" id="working-title">From understanding to use.</h2></div><ol>{process.map(stage => <li><h3>{stage.name}</h3><p>{stage.text}</p></li>)}</ol></section>
  <section class="closing-panel"><div class="shell"><p class="eyebrow">Bring your context</p><h2 class="display">What would a useful<br />next step look like?</h2><a class="button button--dark" href={`/contact?interest=${service.slug}`}>Prepare a brief for this service <span aria-hidden="true">↗</span></a><a class="text-link other-service" href="/services">Compare the other service areas <span aria-hidden="true">↗</span></a></div></section>
</Base>
