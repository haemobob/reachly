---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/content';
import type { Project } from '../../data/content';
import '../../styles/pages.css';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const index = projects.findIndex(item => item.slug === project.slug);
const next = projects[(index + 1) % projects.length];
const observations: Record<string, { focus: string; context: string; consideration: string }> = {
  'sellaku': { focus: 'A place to discover what belongs.', context: 'Furniture shopping begins with looking. Sellaku presents a storefront where the product is the subject and discovery is the starting point.', consideration: 'For a product-led business, the useful questions are often simple: can visitors understand the range, find the item they want, and see a clear next step? This website offers a concrete context for that conversation.' },
  'mac-one-indonesia': { focus: 'Technical services, made legible.', context: 'Mac One Indonesia brings together HVACR, engineering, industrial automation, and maintenance services in a business website.', consideration: 'A broad technical offer needs clear distinctions. A prospective customer should be able to recognize the relevant service and understand where to go next, without needing to know the whole business first.' },
  'crypto-radius': { focus: 'A digital home for a community.', context: 'Crypto Radius introduces a crypto community alongside signals and market context. Its website gives visitors a place to explore that offer.', consideration: 'Community websites need to make their subject and participation paths understandable. The work shown here is a website project, not an endorsement of financial claims or an investment recommendation.' },
  'crypto-galaxy': { focus: 'An offer with several ways in.', context: 'Crypto Galaxy presents a crypto trading community, with programs, research, and membership information as the website’s central subjects.', consideration: 'When an offer includes different programs and information types, page hierarchy helps visitors find their own starting point. The website project is not an endorsement of trading results or an investment recommendation.' },
};
const note = observations[project.slug];
---
<Base title={`${project.name} — Work`} description={project.summary}>
  <section class="shell page-intro project-intro">
    <a class="text-link" href="/work">← All work</a>
    <p class="eyebrow">Project note / {project.category}</p>
    <h1 class="display page-title">{project.name}</h1>
    <div class="intro-tail"><span class="folio">0{index + 1} / 04</span><p class="lede">{note.focus}</p></div>
  </section>
  <figure class="shell project-plate"><div style={`--project-accent:${project.accent}`}><img src={project.image} alt={`${project.name} website preview`} width="1440" height={project.slug === 'sellaku' ? 845 : 960} fetchpriority="high" /></div><figcaption>Website screenshot / {project.name}. Live websites may change.{project.slug === 'sellaku' && <span> The supplied Sellaku URL currently displays Tekad Jaya branding; the screenshot preserves the source as shown.</span>}</figcaption></figure>
  <section class="shell section-space project-note">
    <aside><p class="eyebrow">At a glance</p><dl><dt>Project</dt><dd>{project.name}</dd><dt>Website subject</dt><dd>{project.category}</dd><dt>Attribution</dt><dd>Reachly client website project</dd></dl><a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Visit website <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></aside>
    <div><p class="eyebrow">The context</p><h2 class="display">{note.focus}</h2><p class="lede">{note.context}</p><p>{note.consideration}</p><div class="honesty-note"><h3>About this project note</h3><p>This is a confirmed Reachly client website project, not a performance case study. The note describes the website’s subject. Detailed delivery scope, dates, and measured outcomes are not presented here.</p></div></div>
  </section>
  <section class="shell next-project"><p class="eyebrow">Next project</p><a href={`/work/${next.slug}`}><span class="display">{next.name}</span><span aria-hidden="true">↗</span></a></section>
  <section class="closing-panel"><div class="shell"><p class="eyebrow">Start with your business</p><h2 class="display">A different context.<br />Your next possibility.</h2><a class="button button--dark" href="/contact?interest=website-design-development">Prepare a website brief <span aria-hidden="true">↗</span></a></div></section>
</Base>
