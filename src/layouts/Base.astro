---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/standard-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string; theme?: 'studio' | 'exhibition'; }
const { title, description = 'Thoughtful websites, digital presence and connected systems for businesses in Indonesia. Reachly brings design and practical technology together.', theme = 'studio' } = Astro.props;
const pathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '') + '/';
const canonical = new URL(pathname, 'https://reachly.id');
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="theme-color" content={theme === 'exhibition' ? '#05100E' : '#FAF7F0'} />
<title>{title} — Reachly</title><link rel="canonical" href={canonical} />
<meta property="og:type" content="website" /><meta property="og:title" content={`${title} — Reachly`} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://reachly.id/og.png" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/brand/favicon.ico" sizes="any" /><link rel="icon" href="/brand/reachly-icon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/brand/reachly-icon-180.png" /><link rel="manifest" href="/brand/site.webmanifest" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<Header exhibition={theme === 'exhibition'} />
<main id="main"><slot /></main>
<Footer exhibition={theme === 'exhibition'} />
<script>import '../scripts/site';</script>
</body>
</html>
